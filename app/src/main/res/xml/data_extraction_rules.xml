<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12+. The myTeamSpeak session tokens
     never leave the device: see data/MyTsSessionStore.kt. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="myts_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="myts_session.xml" />
    </device-transfer>
</data-extraction-rules>
